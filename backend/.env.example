# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# These four values are read by docker-compose.yml to create the Postgres
# container. Keep them in sync with DATABASE_URL below.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=todo_list_node_db
DB_USERNAME=postgres
DB_PASSWORD=

# Connection string used by Prisma.
DATABASE_URL="postgresql://USERNAME:PASSWORD@HOST:PORT/DB_NAME?schema=public"

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=3000

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Secret key used to sign access tokens (HS256).
# Anyone holding this value can forge a token for ANY account, so treat it like
# a database password: never commit it, and use a different value per environment.
#
# Generate one with:  openssl rand -base64 48
JWT_SECRET=
