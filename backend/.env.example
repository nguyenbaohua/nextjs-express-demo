DB_HOST=localhost
DB_PORT=5432
DB_NAME=todo_list_node_db
DB_USERNAME=postgres
DB_PASSWORD=

DATABASE_URL="postgresql://USERNAME:PASSWORD@HOST:PORT/DB_NAME?schema=public"

PORT=3000

# --- AWS Cognito ---------------------------------------------------------
# Cách lấy 4 giá trị này: đọc .note/cognito-setup.md
# Region chứa User Pool, ví dụ ap-southeast-1 (Singapore)
AWS_REGION=
# Mã User Pool, dạng <region>_<chuỗi ngẫu nhiên>
COGNITO_USER_POOL_ID=
# Mã App client
COGNITO_CLIENT_ID=
# Client secret của App client. LÀ MẬT KHẨU — không bao giờ đưa sang frontend.
COGNITO_CLIENT_SECRET=
# Cognito Hosted UI domain — CHỈ CẦN cho tính năng đăng nhập bằng Google.
# Bỏ trống thì luồng email + mật khẩu vẫn chạy bình thường.
# Dán được cả 3 dạng: "my-app", "my-app.auth.ap-southeast-1.amazoncognito.com",
# hoặc "https://my-app.auth.ap-southeast-1.amazoncognito.com".
# Cách tạo: đọc .note/google-login-setup.md
COGNITO_DOMAIN=
