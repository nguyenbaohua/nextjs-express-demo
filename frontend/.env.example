# Base URL of the Express backend API (server-side only, not exposed to the browser)
API_BASE_URL=http://localhost:3000/api

# Public origin of this Next.js app — used to build the Google OAuth redirect URI.
# Must match the "Allowed callback URLs" configured in AWS Cognito.
# See .note/google-login-setup.md
APP_BASE_URL=http://localhost:3001
